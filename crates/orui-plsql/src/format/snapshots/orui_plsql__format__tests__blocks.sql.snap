---
source: crates/orui-plsql/src/format/tests.rs
expression: out
---
create table orders (
  order_id    number(10) generated always as identity,
  customer_id number(10) not null, -- who ordered
  status      varchar2(20 char) default 'NEW' not null,
  created_at  timestamp(6) with time zone default systimestamp,
  constraint orders_pk primary key (order_id),
  constraint orders_status_ck check (status in ('NEW', 'PAID', 'SHIPPED'))
) tablespace users;

create index orders_cust_ix on orders (customer_id, created_at) compress 1;

merge into orders o
using (select :id id, :status status from dual) s
on (o.order_id = s.id)
when matched then
  update set o.status = s.status
  where o.status <> s.status
  delete where s.status = 'CANCELLED'
when not matched then
  insert (customer_id, status)
  values (s.id, s.status);

declare
  type t_orders is table of orders%rowtype index by pls_integer;
  l_orders t_orders;
  l_total  number := 0;
  l_very_long_variable_name_for_testing varchar2(100);
  cursor c_open(p_status varchar2 default 'NEW') is
    select *
    from orders
    where status = p_status
    for update skip locked;
  e_bad exception;
begin
  <<outer_loop>>
  for o in c_open loop
    case o.status
      when 'NEW' then
        l_total := l_total + 1;
      when 'PAID' then
        begin
          update orders
          set status = 'SHIPPED'
          where current of c_open;
        exception
          when others then
            null;
        end;
      else
        raise e_bad;
    end case;
    exit outer_loop when l_total > 100;
  end loop outer_loop;
  open :rc for
    select order_id, status
    from orders
    where customer_id = 42
    order by created_at desc;
  execute immediate 'begin dbms_stats.gather_table_stats(user, :t); end;' using 'ORDERS';
  l_orders(1).status := 'X';
  l_total            := l_total * 2 + (l_total - 1) / 3;
  if l_total > 10
    and l_total < 1000
    and l_very_long_variable_name_for_testing is null
    and sysdate > date '2020-01-01'
  then
    dbms_output.put_line(
      'total: ' || TO_CHAR(l_total, 'FM999G999') || ' / ' || l_very_long_variable_name_for_testing || '!'
    );
  elsif l_total = 0 then
    null; -- nothing to do
  end if;
  while l_total > 0 loop
    l_total := l_total - 1;
  end loop;
  /* a block comment
      spanning lines */
  commit;
exception
  when e_bad or value_error then
    rollback;
    RAISE_APPLICATION_ERROR(-20001, 'bad order: ' || SQLERRM);
end;
/
