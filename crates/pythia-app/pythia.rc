// Windows resources of pythia.exe (#77). eframe sets the window icon at
// runtime, but Explorer, the shortcuts the installers create and the taskbar
// take the icon from the exe. The version strings show in the exe's
// properties, Task Manager and "Open with". build.rs passes the PYTHIA_VERSION
// macros. No #include, so every resource compiler takes it as is.
#pragma code_page(65001)

1 ICON "../../assets/icon/pythia.ico"

1 VERSIONINFO
FILEVERSION PYTHIA_VERSION_MAJOR, PYTHIA_VERSION_MINOR, PYTHIA_VERSION_PATCH, 0
PRODUCTVERSION PYTHIA_VERSION_MAJOR, PYTHIA_VERSION_MINOR, PYTHIA_VERSION_PATCH, 0
FILEOS 0x40004 // VOS_NT_WINDOWS32
FILETYPE 0x1 // VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0" // U.S. English, Unicode
        BEGIN
            VALUE "CompanyName", "Remo Laubacher"
            VALUE "FileDescription", "Pythia"
            VALUE "FileVersion", PYTHIA_VERSION
            VALUE "InternalName", "pythia"
            VALUE "LegalCopyright", "Copyright © 2026 Remo Laubacher"
            VALUE "OriginalFilename", "pythia.exe"
            VALUE "ProductName", "Pythia"
            VALUE "ProductVersion", PYTHIA_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
